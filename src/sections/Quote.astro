---
import QuoteForm from "../components/QuoteForm";
import QuoteImage from "../assets/quote.png";
---

<section id="cotizacion" class="w-full bg-white pb-25 pt-15">
    <div
        class="h-full flex flex-col md:flex-row items-center justify-center lg:justify-between max-w-7xl mx-auto px-4"
    >
        <div
            class="flex flex-col gap-10 w-full md:max-w-2xl scroll-my-20 md:pl-0 md:p-10"
        >
            <h1
                class="text-2xl md:text-4xl font-black text-primary text-center md:text-left"
            >
                Solicita una cotización
            </h1>
            <div data-animate="fade-up" data-animate-delay="0.1">
                <QuoteForm client:visible />
            </div>
        </div>

        <img
            src={QuoteImage.src}
            alt="Velas Montenegro"
            class="hidden lg:block md:h-150 lg:h-155 w-auto shrink-0"
        />
    </div>
</section>
